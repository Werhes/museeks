<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="?android:attr/windowBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="start"
            android:id="@+id/toolbar_close"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_close"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:tint="?attr/text_primary"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/text_primary"
            android:layout_gravity="center_horizontal"
            android:id="@+id/toolbar_header"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/upload_track"/>
        <ImageView
            android:layout_gravity="end"
            android:id="@+id/toolbar_apply"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/ic_check"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:tint="?attr/text_primary"/>
    </FrameLayout>
    <include
        android:id="@+id/fake_track"
        layout="@layout/list_item_track"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="?attr/text_inverse"
        android:id="@+id/hero_play"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/upload_track_btn"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:stateListAnimator="@null"
        app:backgroundTint="?attr/text_primary"
        app:elevation="0dp"
        app:icon="@drawable/ic_document_outline_28"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="?attr/text_inverse"
        app:rippleColor="?attr/text_inverse"/>
    <TextView
        android:textColor="?attr/text_secondary"
        android:id="@+id/disclaimer"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/upload_track_info"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        style="@style/OverlineLess"/>
</LinearLayout>
