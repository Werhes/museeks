<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/bs_root"
    android:paddingTop="16dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ImageView
        android:id="@+id/header_iv"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/placeholder_playlist"/>
    <TextView
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/header_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/header_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:alpha="0.7"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/white"
        android:id="@+id/header_album"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alpha="0.7"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/buttonHandler"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp">
        <com.google.android.material.button.MaterialButton
            android:textColor="?attr/text_inverse"
            android:id="@+id/hero_play"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/mab_play"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:stateListAnimator="@null"
            app:backgroundTint="?attr/text_primary"
            app:elevation="0dp"
            app:icon="@drawable/player_play"
            app:iconGravity="textStart"
            app:iconTint="?attr/text_inverse"
            app:rippleColor="?attr/text_inverse"/>
        <com.google.android.material.button.MaterialButton
            android:textColor="?attr/text_primary"
            android:id="@+id/hero_shuffle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/mab_shuffle"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginStart="8dp"
            android:stateListAnimator="@null"
            app:backgroundTint="?attr/bg_primary"
            app:elevation="0dp"
            app:icon="@drawable/ic_shuffle_outline_24"
            app:iconGravity="textStart"
            app:iconTint="?attr/text_primary"
            app:rippleColor="?attr/text_primary"/>
    </LinearLayout>
</LinearLayout>
