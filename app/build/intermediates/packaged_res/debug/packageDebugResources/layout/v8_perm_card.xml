<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/perm_full"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="?attr/bg_page"
    app:cardCornerRadius="@dimen/vkx_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/bg_primary"
    app:strokeWidth="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/text_secondary"
                android:id="@+id/recommended"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="@string/auth_perm_card_recom"
                android:textAllCaps="true"
                style="@style/Overline"/>
            <ImageView
                android:id="@+id/checked"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:src="@drawable/ic_check_circle_16"
                android:layout_alignTop="@+id/recommended"
                android:layout_alignBottom="@+id/recommended"
                android:layout_marginEnd="16dp"
                android:layout_alignParentEnd="true"
                app:tint="?attr/text_primary"/>
        </RelativeLayout>
        <TextView
            android:textSize="28sp"
            android:textColor="?attr/text_primary"
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/auth_mode_android_title"
            android:fontFamily="@font/vk_sans_display_demibold"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/text_secondary"
            android:id="@+id/desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/auth_mode_android_desc"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
