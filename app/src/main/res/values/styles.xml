<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Кастомные стили, используемые в layout-файлах VK X -->

    <!-- Button styles -->
    <style name="ButtonBarButtonStyleM2" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/global_accent</item>
        <item name="rippleColor">?attr/global_accent</item>
    </style>

    <!-- Base TextButton style (used as @style/TextButton in layouts) -->
    <style name="TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">?attr/global_accent</item>
    </style>

    <style name="TextButton.Blue">
        <item name="android:textColor">?attr/global_accent</item>
    </style>

    <style name="MusicThemedActionBtn" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Base TextStyle (used as @style/TextStyle in layouts) -->
    <style name="TextStyle">
        <item name="android:drawablePadding">4dp</item>
    </style>

    <style name="TextStyle.ListItem">
        <item name="android:drawablePadding">4dp</item>
    </style>

    <style name="TextStyle.ListItem.Title">
        <item name="android:drawablePadding">2dp</item>
    </style>

    <style name="TextStyle.ListItem.TitleLarge">
        <item name="android:drawablePadding">2dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextStyle.ListItem.Snippet">
        <item name="android:drawablePadding">2dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/text_secondary</item>
    </style>

    <!-- Dialog styles -->
    <style name="V2.Dialog2" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
    </style>

    <!-- Toolbar title -->
    <style name="NewToolbarTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Preference fragment -->
    <style name="PreferenceFragmentListStyle" parent="@style/PreferenceFragment.Material">
        <item name="android:listViewStyle">@style/PreferenceListViewStyle</item>
    </style>

    <style name="PreferenceListViewStyle">
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <!-- Preference text styles (used in preference layouts) -->
    <style name="PreferenceSummaryTextStyle" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
    </style>

    <style name="PreferenceCategoryTitleTextStyle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/global_accent</item>
    </style>

    <!-- VKUI Text styles -->
    <style name="VKUIText">
        <item name="android:drawablePadding">4dp</item>
    </style>

    <style name="VKUIText.Title1">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Material Error Text -->
    <style name="MaterialErrorText">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">?attr/colorError</item>
    </style>

    <!-- Overline Less -->
    <style name="OverlineLess">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">?attr/text_secondary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Overline base -->
    <style name="Overline">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/text_secondary</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Overline More -->
    <style name="OverlineMore">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/global_accent</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Music White Action Button -->
    <style name="MusicWhiteActionBtn" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@android:color/white</item>
    </style>

    <!-- VKUI EditText Modified -->
    <style name="VKUIEditTextModified" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
    </style>
</resources>