<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Museeks" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary/Secondary colors -->
        <item name="colorPrimary">@color/sky_300</item>
        <item name="colorPrimaryDark">@color/sky_300</item>
        <item name="colorAccent">@color/sky_300</item>
        <item name="colorSecondary">@color/sky_300</item>

        <!-- Custom VK X attributes -->
        <item name="text_primary">@color/primary_text_default_material_light</item>
        <item name="text_secondary">@color/secondary_text_default_material_light</item>
        <item name="text_inverse">@color/primary_text_default_material_dark</item>
        <item name="bg_primary">@color/background_material_light</item>
        <item name="bg_page">@color/background_floating_material_light</item>
        <item name="global_accent">@color/sky_300</item>
        <item name="separator_alpha">@color/ripple_material_light</item>
        <item name="scrim_color">@color/mtrl_scrim_color</item>
        <item name="scrim_color_lighter">@color/scrim_dark_lighter</item>
        <item name="pref_card_bg">@color/background_material_light</item>
        <item name="reborn_title_color">@color/primary_text_default_material_light</item>
        <item name="alert_background">@color/background_floating_material_light</item>
        <item name="blur_darkening_color">@color/dim_dark</item>
        <item name="bottomsheet_background_color">@color/background_floating_material_light</item>
        <item name="bottomsheet_seperator_color">@color/ripple_material_light</item>
        <item name="splashScreenIconSize">48dp</item>

        <!-- Button colors -->
        <item name="button_primary_background">@color/sky_300</item>
        <item name="button_primary_background_disabled">@color/ripple_material_light</item>
        <item name="button_secondary_background">@color/background_material_light</item>
        <item name="button_secondary_background_disabled">@color/ripple_material_light</item>
        <item name="button_secondary_foreground">@color/primary_text_default_material_light</item>
        <item name="button_secondary_foreground_disabled">@color/secondary_text_default_material_light</item>
        <item name="button_tertiary_background_disabled">@android:color/transparent</item>
        <item name="button_tertiary_foreground">@color/sky_300</item>
        <item name="button_tertiary_foreground_disabled">@color/secondary_text_default_material_light</item>

        <!-- Card -->
        <item name="cardCornerRadius">8dp</item>
        <item name="cornerRadius">8dp</item>

        <!-- Alert dialog -->
        <item name="alertDialogTheme">@style/ThemeOverlay.MaterialComponents.Dialog.Alert</item>

        <!-- Button bar styles -->
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MaterialComponents.Button.TextButton.Dialog</item>

        <!-- Text colors for dialogs -->
        <item name="textColorAlertDialogListItem">@color/primary_text_default_material_light</item>

        <!-- Layout attributes -->
        <item name="bg_header">@color/background_floating_material_light</item>
    </style>
</resources>