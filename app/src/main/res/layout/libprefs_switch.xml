<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root2"
    android:background="?attr/selectableItemBackground"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/text_primary"
            android:id="@+id/pref_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/text_secondary"
            android:id="@+id/pref_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <ua.itaysonlab.vkxreborn.ui.LiquidSwitch
        android:layout_gravity="center_vertical"
        android:id="@+id/pref_switch"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        app:thumbTint="?attr/global_accent"
        app:trackTint="?attr/global_accent"/>
</LinearLayout>
