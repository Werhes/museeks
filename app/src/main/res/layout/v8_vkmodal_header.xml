<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="?android:attr/windowBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/header"
        android:background="?attr/selectableItemBackground"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/song_album"
            android:layout_width="48dp"
            android:layout_height="48dp"/>
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/chevron"
            android:layout_toEndOf="@+id/song_album">
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/text_primary"
                android:gravity="center_vertical"
                android:id="@+id/song_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:drawablePadding="2dp"
                android:drawableTint="?attr/text_primary"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/text_secondary"
                android:ellipsize="end"
                android:id="@+id/song_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/chevron"
            android:layout_width="24dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_right"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            app:tint="?attr/text_primary"/>
    </RelativeLayout>
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <ImageView
            android:id="@+id/action_one"
            android:background="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_download_outline_28"
            android:scaleType="center"
            android:layout_weight="1"
            app:tint="?attr/text_primary"/>
        <ImageView
            android:id="@+id/action_two"
            android:background="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_add_outline_28"
            android:scaleType="center"
            android:layout_weight="1"
            app:tint="?attr/text_primary"/>
        <ImageView
            android:id="@+id/action_three"
            android:background="?attr/selectableItemBackground"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_share_outline_28"
            android:scaleType="center"
            android:layout_weight="1"
            app:tint="?attr/text_primary"/>
        <ImageView
            android:id="@+id/action_four"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_share_outline_28"
            android:scaleType="center"
            android:layout_weight="1"
            app:tint="?attr/text_primary"/>
    </LinearLayout>
</LinearLayout>
